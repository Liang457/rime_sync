[Unit]
Description=rime-sync server (v2, files-only + web console)
After=network.target

[Service]
Type=simple
# 按实际部署环境修改 User / WorkingDirectory / ExecStart 三处路径
User=gk-pi
WorkingDirectory=/home/gk-pi/rime_server
ExecStart=/home/gk-pi/rime_server/.venv/bin/python run.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
